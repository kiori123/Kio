# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser; RLS is what
# actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Anthropic ───────────────────────────────────────────────────────────────
# Server-side only. Never expose this with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: production speech-to-text ─────────────────────────────────────
# Leave unset to use the browser's built-in recognition (Chrome/Edge only).
# DEEPGRAM_API_KEY=
